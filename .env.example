# Server-side only. Never prefix with VITE_: that would ship it to browsers.
# Copy to .env and load it into your shell (see README "Run it locally").

# --- Which vision runtime answers. No automatic fallback between them. ---
# gemini (default): hosted Gemma through Google's Gemini API. Photos leave your machine.
# ollama: a local or self-hosted Ollama runtime. Fixed here, never chosen by the browser.
RAKELESS_PROVIDER=gemini

# Hosted (gemini)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Local (ollama). A loopback URL is labelled "local"; any other host is labelled with its name.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# --- Timing: one deadline per request covers image work, every attempt, and the response. ---
# Defaults: gemini 52000 (fits Vercel's 60 s limit with a reserve); ollama 600000 (CPU inference plus a cold model load can take minutes).
# REQUEST_BUDGET_MS=
# Cap on one upstream attempt (gemini 40000, ollama 580000). Always also bounded by the request deadline.
# MODEL_TIMEOUT_MS=
# A retry starts only if at least this much time is left (gemini 10000, ollama 60000).
# MIN_ATTEMPT_MS=
# RESPONSE_RESERVE_MS=2500

# --- Spend protection (per server process, not global across serverless instances) ---
RATE_PER_IP_10MIN=6
# Upstream model calls per UTC day, retries included.
DAILY_MODEL_CALLS=400
MAX_CONCURRENT_ANALYSES=1
# Trust X-Forwarded-For only behind a proxy you control (Vercel is detected automatically).
# TRUST_PROXY=1

# --- Retention ---
# Observation-only cache (labels + short evidence text, never images). 0 disables it.
OBSERVATION_CACHE_TTL_MS=600000
OBSERVATION_CACHE_SIZE=32
