    "typecheck": "tsc --noEmit -p tsconfig.json",
    "record-example": "tsx scripts/record-example.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
