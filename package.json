{
  "name": "rakeless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,yellow \"tsx watch server/dev.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/dev.ts",
